// All monetary values are stored as INTEGER PESEWAS (GHS 1 = 100 pesewas).
// Never use Float for money fields. GHS 5.00 is stored as 500.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (runtime queries)
  directUrl = env("DIRECT_URL") // direct connection (migrations / DDL)
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

enum RideType {
  LONE
  SHARED
}

enum RideSource {
  APP
  USSD
}

enum RideStatus {
  REQUESTED
  MATCHED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  AWAITING_RIDER_DECISION
}

enum PaymentStatus {
  PENDING
  COLLECTED
  DISBURSED
  FAILED
}

enum PassengerStatus {
  WAITING
  ARRIVED
  PICKED_UP
  DROPPED_OFF
  CANCELLED
}

enum RideCancelReason {
  RIDER_CANCELLED
  DRIVER_BACKED_OUT
  NO_DRIVERS_AVAILABLE
  ALL_PASSENGERS_LEFT
  MERGED_INTO_ANOTHER_RIDE
}

/// Why the RIDER cancelled, as chosen in the app's cancel sheet. Product
/// feedback only, deliberately separate from RideCancelReason (the SYSTEM's
/// reason, which app logic depends on). Mirrors RIDER_CANCEL_REASONS in
/// @rida/shared.
enum RiderCancelReason {
  WAITING_TOO_LONG
  CHANGED_PLANS
  WRONG_ADDRESS
  FOUND_ANOTHER_RIDE
  PRICE
  DRIVER_TOO_SLOW
  DRIVER_ASKED_TO_CANCEL
  OTHER
}

enum PaymentType {
  COLLECTION
  DISBURSEMENT
  REFUND
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
  AWAITING_OTP
  PROMPT_PENDING
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  /// Confirms "delete my account" from the app (services/auth/deleteAccount.ts).
  ACCOUNT_DELETION
}

enum PaymentMethod {
  CASH
  MOMO
}

model User {
  id                    String    @id @default(cuid())
  /// ALWAYS canonical "+233XXXXXXXXX". Normalized at the edge of the auth
  /// routes (routes/auth.ts) and enforced by a CHECK constraint that Prisma
  /// cannot express here:
  ///   User_phone_canonical_check:
  ///     phone LIKE '+233%' OR phone LIKE 'deleted:%'
  /// (migration 20260924210000_phone_canonicalisation). The 'deleted:%' arm
  /// covers DELETE /me, which rewrites this to "deleted:<userId>".
  /// Never write a raw user-typed number here — run normalizePhone first.
  phone                 String    @unique
  name                  String
  role                  UserRole
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  /// Set by DELETE /me. The row is KEPT and anonymized rather than deleted:
  /// Ride.riderId is onDelete: Restrict, and ride/commission history is
  /// financial record we must not lose. Once set, `phone` and `name` hold
  /// placeholders and the account can no longer be logged into.
  deletedAt             DateTime?
  /// Phase 4 safety: ONE emergency contact the rider can notify with an SOS
  /// from an active ride. Deliberately a pair of plain columns rather than a
  /// contacts table — v1 is exactly one contact, and a table would imply a
  /// management UI we are not building.
  emergencyContactName  String?
  emergencyContactPhone String?
  /// An App Store / Google Play review demo account, or one of the demo's
  /// simulated people (services/reviewDemo). Their rides are demo rides:
  /// never matched with real people, never shown to them, not in admin stats.
  isReviewDemo          Boolean   @default(false)
  /// "I'm 18 or older and I agree to the Terms and Privacy Policy": when it
  /// was ticked (at sign-up, or once in the app for accounts from before it
  /// existed), and which version of the terms (TERMS_VERSION in
  /// @rida/shared, the pages' "Last updated" date). Null until confirmed;
  /// POST /auth/signup refuses to create an account without it.
  ageConfirmedAt        DateTime?
  termsAcceptedAt       DateTime?
  termsVersion          String?
  /// Early access (launch mode): when an admin let this rider book during
  /// the countdown before the public launch, null if not. Set one by one or
  /// for every current rider at once in the admin site's Settings.
  earlyAccessAt         DateTime?

  driver                 Driver?
  ridesAsRider           Ride[]                @relation("RiderRides")
  ridesAsDriver          Ride[]                @relation("DriverRides")
  ridePassengers         RidePassenger[]
  payments               Payment[]
  refreshTokens          RefreshToken[]
  ratingsGiven           Rating[]              @relation("RatingsGiven")
  ratingsReceived        Rating[]              @relation("RatingsReceived")
  driverCommissionLedger CommissionLedger[]    @relation("DriverCommission")
  rideRejections         RideRejection[]       @relation("DriverRejections")
  pushTokens             PushToken[]
  trackingLinks          TrackingLink[]
  accountDeletion        AccountDeletion?
  driverOnlineSessions   DriverOnlineSession[]
  rideOffers             RideOffer[]
  driverLocationPoints   DriverLocationPoint[]
  adminPasskeys          AdminPasskey[]
  cashPayments           DriverCashPayment[]
  sosEvents              SosEvent[]

  /// Sign-ups per day (admin Riders page).
  @@index([createdAt])
}

/// One per closed account. Closing an account hides the person at once (the
/// User row shows placeholders); what is needed for a safety dispute or a
/// police request (name, phone, a driver's plate and photo) is moved here,
/// out of every table the apps or the admin site read, and erased at
/// `purgeAfter` (ACCOUNT_DELETION_RETENTION_DAYS, default 90), together with
/// the person's notes, exact pins and rating comments
/// (services/auth/deleteAccount.ts, purgeDeletedAccounts).
model AccountDeletion {
  id           String    @id @default(cuid())
  userId       String    @unique
  requestedAt  DateTime  @default(now())
  purgeAfter   DateTime
  purgedAt     DateTime?
  keptName     String?
  keptPhone    String?
  keptPlate    String?
  keptPhotoUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purgeAfter])
}

model Driver {
  id              String    @id @default(cuid())
  userId          String    @unique
  /// Nullable until the driver completes their profile (Phase 3:
  /// completeDriverProfile) — a Driver row is created at signup with these
  /// fields empty and isApproved=false.
  carMake         String?
  carModel        String?
  carColor        String?
  plate           String?
  photoUrl        String?
  isApproved      Boolean   @default(false)
  isOnline        Boolean   @default(false)
  currentZoneId   String?
  /// Where the driver's app last said they were (sent with going online and
  /// with zone updates; apps from before 2026-10-29 send none). The server
  /// checks it against the service area; also for the admin live map.
  lastLat         Float?
  lastLng         Float?
  lastSeenAt      DateTime?
  /// Suspended by an admin (admin site, Drivers): can't go online until an
  /// admin lifts it. Separate from isApproved — a suspension keeps the
  /// approval and says why. `suspendedBy` is the admin's User.id (plain
  /// column, like AdminAuditLog.actor). The audit log keeps the history.
  suspendedAt     DateTime?
  suspendedReason String?   @db.VarChar(500)
  suspendedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentZone Zone? @relation(fields: [currentZoneId], references: [id], onDelete: SetNull)

  @@index([isOnline])
  @@index([currentZoneId])
}

model Zone {
  id        String    @id @default(cuid())
  name      String
  quadrant  String
  latitude  Float
  longitude Float
  /// Set when a zone is taken out of service (e.g. "Accra Mall Junction",
  /// off campus, 2026-10). The row stays — old rides reference it and show
  /// its name — but nothing new uses it: no pin is derived to it, it isn't
  /// served by GET /zones, a driver can't be in it, eligibility never flows
  /// through it, and the realign and route precompute scripts skip it.
  /// Set by src/scripts/realignZones.ts (RETIRED_ZONES).
  retiredAt DateTime?

  drivers           Driver[]
  pickupRides       Ride[]          @relation("PickupZone")
  dropoffRides      Ride[]          @relation("DropoffZone")
  passengerPickups  RidePassenger[] @relation("PassengerPickup")
  passengerDropoffs RidePassenger[] @relation("PassengerDropoff")
  adjacencies       ZoneAdjacency[] @relation("ZoneAdjacencies")
  adjacentTo        ZoneAdjacency[] @relation("AdjacentZones")
  routesFrom        ZoneRoute[]     @relation("RouteFrom")
  routesTo          ZoneRoute[]     @relation("RouteTo")
  places            Place[]
}

enum PlaceCategory {
  HALL
  HOSTEL
  FACULTY
  GATE
  FOOD
  LANDMARK
  OTHER
}

/// A named campus spot riders can search for and pick ("Balme Library",
/// "Night Market"). Seeded from OpenStreetMap (src/scripts/places/) and
/// edited in the admin site. A ride stores the place's id, name and
/// coordinates at booking time, so editing or deactivating a place never
/// rewrites history.
model Place {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(120)
  /// Short alternative names for search ("Balme", "UGBS", "Night market").
  aliases   String[]      @default([])
  latitude  Float
  longitude Float
  category  PlaceCategory @default(OTHER)
  /// Nearest zone, recomputed by the server whenever the place moves.
  zoneId    String
  isActive  Boolean       @default(true)
  /// "osm:way/278303018" for seeded rows, null for places added by hand.
  source    String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([isActive])
}

/// Road routes through exact points (a trip's pins, or the driver and the
/// stops ahead), cached so OSRM is asked once per set of points rather than
/// per screen. Keyed by the points rounded to 4 decimals (about 11 m). See
/// services/routing/pointRoutes.ts.
model PointRoute {
  key             String   @id
  polyline        String
  distanceMeters  Int
  durationSeconds Int
  /// Per leg (point i to point i+1), so each stop gets its own ETA.
  legDistances    Int[]    @default([])
  legDurations    Int[]    @default([])
  provider        String
  createdAt       DateTime @default(now())
}

/// A road route between two campus zones, precomputed once by
/// src/scripts/precomputeZoneRoutes.ts so the apps can draw real roads
/// instead of straight lines without calling a routing service per trip.
model ZoneRoute {
  id              String   @id @default(cuid())
  fromZoneId      String
  toZoneId        String
  /// Google encoded polyline, precision 5 (what OSRM and openrouteservice return).
  polyline        String
  distanceMeters  Int
  durationSeconds Int
  /// Which routing service produced it ("osrm" | "ors").
  provider        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromZone Zone @relation("RouteFrom", fields: [fromZoneId], references: [id], onDelete: Cascade)
  toZone   Zone @relation("RouteTo", fields: [toZoneId], references: [id], onDelete: Cascade)

  @@unique([fromZoneId, toZoneId])
}

model ZoneAdjacency {
  id             String @id @default(cuid())
  zoneId         String
  adjacentZoneId String

  zone         Zone @relation("ZoneAdjacencies", fields: [zoneId], references: [id], onDelete: Restrict)
  adjacentZone Zone @relation("AdjacentZones", fields: [adjacentZoneId], references: [id], onDelete: Restrict)

  @@unique([zoneId, adjacentZoneId])
  @@index([zoneId])
}

model Ride {
  id                 String             @id @default(cuid())
  riderId            String
  driverId           String?
  type               RideType
  status             RideStatus         @default(REQUESTED)
  /// USSD vs app-originated ride — drives SMS vs push notification on transitions.
  source             RideSource         @default(APP)
  pickupZoneId       String
  dropoffZoneId      String
  occupancy          Int                @default(1)
  /// Fare total in pesewas — computed at completion, null until then
  fareTotal          Int?
  /// Driver's share in pesewas — computed at completion, null until then
  driverShare        Int?
  paymentStatus      PaymentStatus      @default(PENDING)
  /// Cash-only launch (Phase 1): defaults to CASH so a client that omits
  /// paymentMethod can never create a ride that is unsettleable (digital
  /// payment is gated off) and that would skip the CASH CommissionLedger
  /// write. Revisit when MOOLRE_ENABLED is turned back on.
  paymentMethod      PaymentMethod      @default(CASH)
  /// Reason recorded on every CANCELLED transition; null otherwise
  cancelReason       RideCancelReason?
  /// Rider's own answer in the cancel sheet (null for system cancels and
  /// for cancels from app builds that predate the sheet).
  riderCancelReason  RiderCancelReason?
  /// Optional free text, usually with OTHER. Max 200 chars (RIDER_CANCEL_NOTE_MAX).
  riderCancelNote    String?            @db.VarChar(200)
  createdAt          DateTime           @default(now())
  departedAt         DateTime?
  completedAt        DateTime?
  /// LEGACY (read-only since 2026-10-15): the one SOS tracking token per
  /// ride, from before links were per rider. New SOS links are TrackingLink
  /// rows; /track/:token still answers an old token from here. Nothing
  /// writes it any more — drop it once no live link can still use it.
  trackingToken      String?            @unique
  /// When a driver first took it (stats: time to match). Null before 2026-10-30.
  matchedAt          DateTime?
  /// When it was cancelled (who: cancelReason). Null before 2026-10-30.
  cancelledAt        DateTime?
  /// The first time its window passed with no driver (it went to
  /// AWAITING_RIDER_DECISION), even if a driver came later. Stats only.
  noDriverFoundAt    DateTime?
  /// Stamped when the ride enters REQUESTED and is broadcast to eligible
  /// drivers; the 90s dispatch timeout is measured from this (or createdAt
  /// if never set).
  broadcastStartedAt DateTime?
  /// Stamped when the ride enters AWAITING_RIDER_DECISION; the 90s grace
  /// period for the rider to choose is measured from this.
  decisionStartedAt  DateTime?
  /// Set when this ride is absorbed into another car via addRiderToCar
  /// (Phase 2d): the request ride is closed (CANCELLED,
  /// MERGED_INTO_ANOTHER_RIDE) and points at the anchor ride it joined.
  mergedIntoRideId   String?
  /// Exact pickup/drop-off pins (2026-10 "exact pins"). All nullable: a ride
  /// from an app build that predates them has none, and everything falls
  /// back to the zone centre exactly as before. The zone ids above are still
  /// ALWAYS set — derived by the server as the nearest zone to the pin — so
  /// dispatch, eligibility, fares and shared matching never see a difference.
  /// Coordinates are private: only the rider, their assigned driver and
  /// admins ever receive them (see routes/ridePins.ts).
  pickupLat          Float?
  pickupLng          Float?
  /// Server-derived display name ("Balme Library", "Near Volta Hall").
  pickupLabel        String?            @db.VarChar(120)
  /// The campus Place the rider chose, when they chose one (not a pin).
  pickupPlaceId      String?
  dropoffLat         Float?
  dropoffLng         Float?
  dropoffLabel       String?            @db.VarChar(120)
  dropoffPlaceId     String?
  /// Optional rider note for the driver ("At the main gate, blue shirt").
  pickupNote         String?            @db.VarChar(140)
  /// A review demo ride (services/reviewDemo): only demo accounts ever see,
  /// take or are matched to it; left out of admin lists and stats.
  isReviewDemo       Boolean            @default(false)

  rider            User              @relation("RiderRides", fields: [riderId], references: [id], onDelete: Restrict)
  driver           User?             @relation("DriverRides", fields: [driverId], references: [id], onDelete: Restrict)
  pickupZone       Zone              @relation("PickupZone", fields: [pickupZoneId], references: [id], onDelete: Restrict)
  dropoffZone      Zone              @relation("DropoffZone", fields: [dropoffZoneId], references: [id], onDelete: Restrict)
  passengers       RidePassenger[]
  payments         Payment[]
  mergedInto       Ride?             @relation("RideMerge", fields: [mergedIntoRideId], references: [id], onDelete: SetNull)
  mergedRides      Ride[]            @relation("RideMerge")
  ratings          Rating[]
  commissionLedger CommissionLedger?
  rejections       RideRejection[]
  offers           RideOffer[]
  trackingLinks    TrackingLink[]
  sosEvents        SosEvent[]

  @@index([status])
  /// The admin dashboard's period queries (requests, rides, completions).
  @@index([createdAt])
  @@index([completedAt])
  @@index([isReviewDemo])
  @@index([riderId])
  @@index([driverId])
  @@index([pickupZoneId])
  @@index([mergedIntoRideId])
}

model RidePassenger {
  id             String          @id @default(cuid())
  rideId         String
  riderId        String
  pickupZoneId   String
  dropoffZoneId  String
  /// Fare charged in pesewas — null until computed
  fareCharged    Int?
  /// Price-locked fare in pesewas, set at join-time and ratcheted downward
  /// only as occupancy increases; frozen permanently once the ride departs
  lockedFare     Int?
  status         PassengerStatus @default(WAITING)
  /// When the driver reached this rider's pickup (WAITING -> ARRIVED). Starts
  /// the rider's wait timer; "rider didn't show" unlocks 3 minutes after it.
  arrivedAt      DateTime?
  /// Set when the driver cancelled this seat because the rider didn't show.
  noShowAt       DateTime?
  /// Set at join time; the stable ascending sort key for the driver's
  /// per-passenger list so first-added stays on top and order never shifts
  /// on a status change.
  createdAt      DateTime        @default(now())
  /// This rider's own exact pins (copied from their request ride when they
  /// join a car). Same meaning and privacy as the Ride columns.
  pickupLat      Float?
  pickupLng      Float?
  pickupLabel    String?         @db.VarChar(120)
  pickupPlaceId  String?
  dropoffLat     Float?
  dropoffLng     Float?
  dropoffLabel   String?         @db.VarChar(120)
  dropoffPlaceId String?
  pickupNote     String?         @db.VarChar(140)

  ride        Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rider       User @relation(fields: [riderId], references: [id], onDelete: Restrict)
  pickupZone  Zone @relation("PassengerPickup", fields: [pickupZoneId], references: [id], onDelete: Restrict)
  dropoffZone Zone @relation("PassengerDropoff", fields: [dropoffZoneId], references: [id], onDelete: Restrict)

  @@index([rideId])
  /// "Does this rider have an active ride?" (services/ride/activeRide.ts) runs
  /// on every booking and every app's active-ride poll; without this it read
  /// the whole table each time, slower with every ride ever taken (Stage 6).
  @@index([riderId])
}

model Payment {
  id           String              @id @default(cuid())
  rideId       String
  riderId      String
  /// Amount in pesewas — never use Float for money
  amount       Int
  type         PaymentType
  status       PaymentRecordStatus @default(PENDING)
  /// Our deterministic externalRef (idempotency key, e.g. collect:{rideId}:{riderId}).
  /// @unique enforces the double-charge guard at the DB layer, closing the
  /// check-then-create race in initiateCollection (report finding 6a).
  providerRef  String?             @unique
  /// Moolre's own transaction id (the TR099 `data` uuid) — distinct from providerRef (our externalRef). Null until a PROMPT_SENT collect() outcome is recorded.
  providerTxId String?
  createdAt    DateTime            @default(now())

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rider User @relation(fields: [riderId], references: [id], onDelete: Restrict)

  @@index([rideId])
  @@index([riderId])
}

model OtpCode {
  id           String     @id @default(cuid())
  phone        String
  /// SHA-256 hash of the 6-digit code — never store the raw code.
  codeHash     String
  purpose      OtpPurpose
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([phone])
}

/// Isolated, short-TTL OTP store for the PUBLIC showcase demo (/demo/otp/*).
/// Deliberately separate from OtpCode so the demo's abusable, unauthenticated
/// surface can never interfere with the real signup/login OTP flow. Rows are
/// swept after 24h (see services/demoOtp) — long enough for the daily/global
/// rate-limit windows, short enough to keep the table tiny.
model DemoOtp {
  id        String   @id @default(cuid())
  /// Normalized local form, e.g. "0594826328".
  phone     String
  /// SHA-256 hash of the 6-digit code — never store the raw code.
  codeHash  String
  /// Request IP, for per-IP rate limiting only. Never logged.
  ip        String?
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
  @@index([ip])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  /// SHA-256 hash of the refresh token — never store the raw token.
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  /// Rotation chain ("family") this token belongs to: the id of the token
  /// issued at login, inherited by every token rotated out of it. Presenting
  /// an already-consumed token means a copy is in circulation, so the whole
  /// family is revoked at once — see authService.refresh.
  familyId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
}

/// An Expo push token: one row per app install on a phone (services/push).
/// Registered by the app after the user allows notifications, deleted on log
/// out, on account deletion, and when Expo reports the install is gone
/// (DeviceNotRegistered). The same phone signing in as someone else moves the
/// row to them, so a token only ever reaches the person signed in on it.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  /// "ExponentPushToken[...]". Identifies one install of one app.
  token     String   @unique @db.VarChar(255)
  /// Which app it belongs to: "rider" or "driver". A send only uses the
  /// tokens of the app the message is for.
  app       String   @db.VarChar(10)
  /// "android" or "ios".
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The public SOS tracking page link (GET /track/:token) — ONE PER RIDER PER
/// RIDE. Minted on that rider's first SOS for the ride and reused by later
/// ones, so a link already texted to a contact keeps working. Per rider
/// because the page shows that rider's name, phone and stops: when it was one
/// token per ride, a passenger's SOS sent their contact a page about the
/// person who booked the car.
///
/// The token is the only credential for the page: 32 hex characters from a
/// CSPRNG. The link stops working TRACKING_LINK_TTL_HOURS after the ride ends.
model TrackingLink {
  token     String   @id @db.VarChar(64)
  rideId    String
  /// Whose SOS this is — the rider the page is about.
  riderId   String
  createdAt DateTime @default(now())

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rider User @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([rideId, riderId])
}

/// Phase 5c: a rider rating their driver (or vice versa, in future) at the
/// end of a COMPLETED ride. Minimal — one rating per (ride, rater, ratee).
model Rating {
  id        String   @id @default(cuid())
  rideId    String
  raterId   String
  rateeId   String
  /// 1-5, validated at the application layer.
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rater User @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Restrict)
  ratee User @relation("RatingsReceived", fields: [rateeId], references: [id], onDelete: Restrict)

  @@unique([rideId, raterId, rateeId])
  @@index([rateeId])
  @@index([createdAt])
}

/// Phase 4: a driver explicitly declining a broadcast ride. Previously a
/// driver could only ignore a request and let it time out, which is
/// indistinguishable from a driver who never saw it. A row here removes the
/// ride from that driver's eligible list immediately while leaving it
/// available to everyone else.
model RideRejection {
  id           String   @id @default(cuid())
  rideId       String
  driverUserId String
  createdAt    DateTime @default(now())
  /// Why (2026-10, ride offers): "DECLINED" (the driver tapped Decline) or
  /// "TIMED_OUT" (the offer's countdown ran out). For stats only — neither
  /// penalises the driver. Null on rows from before offers.
  reason       String?  @db.VarChar(20)

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver User @relation("DriverRejections", fields: [driverUserId], references: [id], onDelete: Cascade)

  @@unique([rideId, driverUserId])
  @@index([driverUserId])
}

/// Tracks the 15% platform commission owed on CASH rides.
/// One row per CASH ride; created when the driver marks the ride complete.
model CommissionLedger {
  id            String   @id @default(cuid())
  driverUserId  String
  rideId        String   @unique
  amountPesewas Int
  createdAt     DateTime @default(now())

  driver User @relation("DriverCommission", fields: [driverUserId], references: [id], onDelete: Restrict)
  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([driverUserId])
}

enum LaunchMode {
  OFF
  COUNTDOWN
  LIVE
}

/// Launch mode (@rida/shared launch/launchMode.ts): at most one row, id
/// "launch"; no row means OFF. During COUNTDOWN only exempt riders (review
/// demo accounts, admins, early access) can book, and from `launchAt` on it
/// counts as LIVE by itself (nothing rewrites the row). Edited only through
/// services/launch/launchSettings.ts, which writes the audit log with it.
model LaunchSetting {
  id                String     @id @default("launch")
  mode              LaunchMode @default(OFF)
  /// The public launch moment; set while mode is COUNTDOWN, null otherwise.
  launchAt          DateTime?
  updatedAt         DateTime   @updatedAt
  /// User.id of the admin who last changed it. Plain column, like AdminAuditLog.actor.
  updatedBy         String?
  /// "Send 'CampusRide is live!' when launch mode turns Live" (Settings).
  /// Off by default. The push itself goes out at most once ever: it is the
  /// Broadcast row with key "launch" (services/push/broadcast.ts).
  launchPushEnabled Boolean    @default(false)
}

enum BroadcastKind {
  RIDERS
  DRIVERS
  EVERYONE
  PHONE
  /// "Send test to me": the admin's own number.
  TEST
  /// The one-time launch push.
  LAUNCH
}

enum BroadcastStatus {
  SENDING
  SENT
  /// Nothing could be sent (push switched off, or the send failed outright).
  FAILED
}

/// A notification sent from the admin site's Notifications page (or the
/// launch push): the send history. The text and the counts only — never the
/// push tokens, and a single recipient's number only masked.
model Broadcast {
  id          String          @id @default(cuid())
  /// Set only for a send that may happen once ever ("launch"). Unique, so a
  /// second attempt — another restart, Live switched off and on — fails to
  /// insert and sends nothing.
  key         String?         @unique @db.VarChar(40)
  /// User.id of the admin who sent it; "system" for the launch push. Plain
  /// column, like AdminAuditLog.actor.
  actor       String
  kind        BroadcastKind
  /// PHONE and TEST: the account sent to (User.id), if there was one.
  recipientId String?
  /// PHONE and TEST: the number, masked ("+233*****146").
  maskedPhone String?         @db.VarChar(20)
  title       String          @db.VarChar(50)
  body        String          @db.VarChar(150)
  status      BroadcastStatus @default(SENDING)
  /// App installs it was addressed to.
  devices     Int             @default(0)
  /// Accepted for delivery by Expo. A later delivery failure (Expo's
  /// receipt, ~15 minutes on) moves one from here to `failed`.
  delivered   Int             @default(0)
  failed      Int             @default(0)
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?

  @@index([createdAt])
  @@index([kind, createdAt])
}

/// Phase 5: an append-only record of every action an admin takes in the admin
/// app, and (Stage 3) of every attempt to sign in to it. Approving or rejecting a driver is an irreversible-feeling, real-world
/// decision (it decides who can earn), so each one must be attributable to a
/// named admin after the fact. Deliberately NOT a relation-heavy model:
/// `target` is a free-form id (today a Driver.id) and `actor` is a User.id
/// held as a plain column, so a row survives the referenced user being
/// anonymized by DELETE /me. Rows are never updated or deleted.
model AdminAuditLog {
  id        String   @id @default(cuid())
  /// User.id of the admin who performed the action. Plain column, not a FK —
  /// the log must outlive the account.
  actor     String
  /// Machine-readable verb, e.g. "driver.approve" / "driver.reject".
  action    String
  /// Id of the thing acted on — a Driver.id for the approval actions.
  target    String
  /// Optional operator-supplied justification (the reject reason).
  reason    String?
  timestamp DateTime @default(now())
  /// Admin sign-in events (action "admin.login.*", Stage 3): where the
  /// attempt came from, so a stranger signing in — say after a SIM swap —
  /// stands out on the admin site's "Recent admin logins". Null for other
  /// actions and for rows from before these columns.
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)

  @@index([actor])
  @@index([target])
  @@index([timestamp])
  @@index([action, timestamp])
}

// ─── Records for the admin dashboard (services/stats) ──────────────────────

enum DriverSessionEnd {
  /// The driver went offline in the app.
  OFFLINE
  /// The server took the driver offline after losing touch with the phone
  /// (app last in front, no connection, nothing heard for
  /// DRIVER_SILENCE_TIMEOUT_MIN); the session ends at the last contact.
  TIMEOUT
  /// An admin took the driver's approval away.
  ADMIN
  ACCOUNT_CLOSED
}

/// One stretch of a driver being online: hours online per driver per day.
/// Opened when they go online (or when their app is heard from again after
/// a timeout while still online), closed with why it ended.
model DriverOnlineSession {
  id           String            @id @default(cuid())
  driverUserId String
  startedAt    DateTime
  /// The last time the server heard from the driver's app during it (its
  /// positions; written about once a minute). Null when none came.
  lastSeenAt   DateTime?
  endedAt      DateTime?
  endReason    DriverSessionEnd?

  driver User @relation(fields: [driverUserId], references: [id], onDelete: Cascade)

  @@index([driverUserId, startedAt])
  @@index([endedAt])
}

enum RideOfferOutcome {
  ACCEPTED
  DECLINED
  TIMED_OUT
  /// Another driver took it (or added the rider to their car).
  TAKEN
  /// The rider cancelled while it was open.
  CANCELLED
  /// Its window ran out with nobody taking it.
  EXPIRED
}

/// A request offered to a driver, and what became of it. One row per ride
/// and driver (an offer sent again keeps its first time).
model RideOffer {
  id           String            @id @default(cuid())
  rideId       String
  driverUserId String
  offeredAt    DateTime
  outcome      RideOfferOutcome?
  /// When the outcome happened: the driver's answer, or the offer closing.
  decidedAt    DateTime?

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver User @relation(fields: [driverUserId], references: [id], onDelete: Cascade)

  @@unique([rideId, driverUserId])
  @@index([driverUserId, offeredAt])
  @@index([offeredAt])
}

/// Where an online driver was: about one point every 30 seconds (services/stats/locationTrail.ts),
/// written in batches. Deleted after 90 days (LOCATION_TRAIL_KEEP_DAYS),
/// as the privacy policy says. Never shown to riders.
model DriverLocationPoint {
  id           BigInt   @id @default(autoincrement())
  driverUserId String
  latitude     Float    @db.Real
  longitude    Float    @db.Real
  recordedAt   DateTime
  /// On a trip at the time (positions sent with a ride).
  onTrip       Boolean  @default(false)

  driver User @relation(fields: [driverUserId], references: [id], onDelete: Cascade)

  @@index([driverUserId, recordedAt])
  @@index([recordedAt], type: Brin)
}

/// An admin's passkey (Face ID / Touch ID; services/auth/passkeys.ts): the
/// main way into the admin site. Only the public key is stored; the private
/// key never leaves the admin's devices. Once an admin has one, phone-code
/// sign-in for them is refused unless ADMIN_OTP_FALLBACK=on.
model AdminPasskey {
  id           String    @id @default(cuid())
  userId       String
  /// The credential's id (base64url), as the browser reports it.
  credentialId String    @unique @db.VarChar(512)
  publicKey    Bytes
  /// The authenticator's signature counter (0 for synced passkeys, which don't count).
  counter      BigInt    @default(0)
  /// How the browser can reach it ("internal", "hybrid", …), comma-separated.
  transports   String?   @db.VarChar(100)
  /// Synced to other devices (iCloud Keychain and the like).
  backedUp     Boolean   @default(false)
  /// The admin's own label ("MacBook", "iPhone").
  name         String    @db.VarChar(60)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Admin dashboard v2 (routes/adminDashboard.ts) ─────────────────────────

enum CashPaymentMethod {
  CASH
  MOMO
  OTHER
}

/// Money a driver handed over to CampusRide against the 15% commission they
/// owe on cash rides (CommissionLedger). Recorded by an admin on the Cash
/// owed page. A ledger: rows are never edited or deleted. A mistake is put
/// right by a REVERSAL — a new row with the negative amount, `reversesId`
/// pointing at the row it cancels, and a reason. A driver's balance is
/// Σ CommissionLedger.amountPesewas − Σ amountPesewas here
/// (docs/admin-metrics.md).
model DriverCashPayment {
  id             String            @id @default(cuid())
  driverUserId   String
  /// Pesewas. Positive for a payment, negative for a reversal.
  amountPesewas  Int
  method         CashPaymentMethod
  note           String?           @db.VarChar(500)
  /// When the driver paid (chosen by the admin, default: when recorded).
  paidAt         DateTime
  /// User.id of the admin who recorded it. Plain column, like AdminAuditLog.actor.
  recordedBy     String
  createdAt      DateTime          @default(now())
  /// A reversal: the payment it cancels (at most one reversal per payment).
  reversesId     String?           @unique
  reversalReason String?           @db.VarChar(500)

  driver   User               @relation(fields: [driverUserId], references: [id], onDelete: Restrict)
  reverses DriverCashPayment? @relation("CashPaymentReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal DriverCashPayment? @relation("CashPaymentReversal")

  @@index([driverUserId, paidAt])
  @@index([paidAt])
}

/// One SOS a rider raised (services/safety/sos.ts): who was told, and
/// whether an admin has dealt with it (Safety page). A repeat press within
/// the repeat window, which texts nobody again, is not a new row. Review
/// demo SOSes aren't recorded.
model SosEvent {
  id              String    @id @default(cuid())
  rideId          String
  riderId         String
  createdAt       DateTime  @default(now())
  /// The ride's status at the time ("IN_PROGRESS").
  rideStatus      String    @db.VarChar(30)
  /// Where the car was at the time (the driver's last live position, if
  /// heard in the last 2 minutes). Null otherwise.
  latitude        Float?
  longitude       Float?
  hasContact      Boolean   @default(false)
  smsDelivered    Boolean   @default(false)
  supportNotified Boolean   @default(false)
  handledAt       DateTime?
  /// User.id of the admin who marked it handled.
  handledBy       String?
  handledNote     String?   @db.VarChar(1000)

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rider User @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([handledAt])
  @@index([rideId])
}
