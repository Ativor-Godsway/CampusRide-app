# DATABASE_URL must be Neon's POOLED (PgBouncer) endpoint — host ends in
# "-pooler". `pgbouncer=true` tells Prisma to skip named prepared statements
# (required for PgBouncer transaction-mode pooling). `connection_limit` caps
# Prisma's own internal pool — keep this low (e.g. 5) for serverless Neon so
# Prisma doesn't open more connections than the pooler/plan can sustain
# alongside other processes (P2024 "Timed out fetching a new connection from
# the pool" / P1001 "Can't reach database server" both come from this being
# too high or unset).
DATABASE_URL="postgresql://user:password@pooler.host/rida?sslmode=require&pgbouncer=true&connection_limit=5"
# DIRECT_URL must be the non-pooled Neon connection string.
# Used by Prisma for migrations (pooled connections can't run DDL).
# In Neon dashboard: Connection string → toggle "Pooled connection" OFF.
DIRECT_URL="postgresql://user:password@direct.host/rida?sslmode=require"
PORT=3000
NODE_ENV=development

# Secret used to sign access tokens and short-lived OTP-verification tokens.
# Generate a long random value, e.g.: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"

# mNotify (real OTP SMS) — only used when MNOTIFY_ENABLED=true (see
# src/services/otp/MnotifyOtpService.ts). Tests and dev default to
# DummyOtpService and never need these.
MNOTIFY_ENABLED=false
MNOTIFY_API_KEY=""
MNOTIFY_SENDER_ID="CampusRide"

# Moolre is gated by TWO INDEPENDENT flags (Phase 2). They used to be one
# MOOLRE_ENABLED switch, which made "real login SMS while payments stay off"
# impossible to express. Each falls back to the legacy MOOLRE_ENABLED when
# unset, so old environments behave exactly as before.
#
# Payments: collection/disbursement + POST /webhooks/moolre. FALSE for the
# cash-only launch — when false, initiate-payment answers PAYMENTS_CASH_ONLY
# and the webhook route is not registered at all.
MOOLRE_PAYMENTS_ENABLED=false
# SMS (VAS): OTP delivery and USSD ride notifications. Set TRUE in production
# together with OTP_PROVIDER=moolre, MOOLRE_VAS_KEY and MOOLRE_SMS_SENDER_ID.
MOOLRE_SMS_ENABLED=false
# https://sandbox.moolre.com for now, https://api.moolre.com for live. Never hardcode.
MOOLRE_BASE_URL="https://sandbox.moolre.com"
# X-API-USER header (username, sent on all calls).
MOOLRE_API_USER=""
# X-API-PUBKEY header — collection calls only.
MOOLRE_PUBLIC_KEY=""
# X-API-KEY header — transfer/disbursement + validate-name. Moves money out;
# the most sensitive secret in the system. Never log, never commit.
MOOLRE_PRIVATE_KEY=""
# Your Moolre account number, sent on all calls.
MOOLRE_ACCOUNT_NUMBER=""
# The `secret` Moolre includes in webhook payloads — verified by
# POST /webhooks/moolre before trusting any webhook.
MOOLRE_WEBHOOK_SECRET=""
# X-API-VASKEY header — SMS (VAS) calls only, e.g. /open/sms/send. A separate
# key from the payment keys above. Never log, never commit.
MOOLRE_VAS_KEY=""
# Sender ID for Moolre SMS — must be pre-registered and approved with Moolre
# before use (same lead-time consideration as the mNotify sender ID).
MOOLRE_SMS_SENDER_ID=""

# Selects the OTP delivery provider: "moolre" | "mnotify" | "dummy" (default).
# See src/services/active.ts for the full precedence/fallback rules.
# - "moolre"  -> MoolreOtpService, only if MOOLRE_SMS_ENABLED=true and
#                MOOLRE_VAS_KEY + MOOLRE_SMS_SENDER_ID are set.
# - "mnotify" -> MnotifyOtpService, only if MNOTIFY_ENABLED=true.
# - anything else (incl. unset) -> DummyOtpService (tests/dev default; never
#                sends a real SMS, and prints the code ONLY when
#                NODE_ENV=development).
# The server REFUSES TO BOOT if this resolves to DummyOtpService while
# NODE_ENV=production — a server that cannot deliver login codes is not
# serviceable (see services/active.ts).
OTP_PROVIDER="dummy"

# Comma-separated browser origins allowed to call the API (HTTP CORS and
# Socket.io share this list). This is the CLIENT's origin, not this server's.
# When EMPTY: no browser origin is allowed in production, and any origin is
# reflected outside production. Native apps send no Origin header and are
# unaffected either way.
#
# Trailing slashes are stripped for you, but write them without: a browser's
# Origin header is scheme+host+port only.
# e.g. "https://campusride-admin.onrender.com"
CORS_ALLOWED_ORIGINS=""
# Legacy name for the same list, still honoured as a fallback when
# CORS_ALLOWED_ORIGINS is unset OR blank.
DEMO_OTP_CORS_ORIGINS=""

# Number of trusted reverse-proxy hops in front of the app, used to resolve
# the real client IP from X-Forwarded-For for rate limiting. Render terminates
# TLS at exactly one proxy, so "1" is correct there. Unset means 1 in
# production and 0 (trust nothing) elsewhere. May also be an IP/CIDR list,
# e.g. "10.0.0.0/8,192.168.0.0/16".
# NEVER set this to "true": that trusts the entire forwarded chain, letting
# any client spoof its IP and get a fresh rate-limit bucket per request.
TRUST_PROXY=

# ── Cloudinary: SIGNED driver-photo uploads ───────────────────────────────
# The apps hold no Cloudinary credential; they request a short-lived signature
# from POST /uploads/driver-photo/signature. CLOUDINARY_API_SECRET is the
# signing key — server-only, never prefixed EXPO_PUBLIC_, never committed.
# Without all three set, that endpoint answers 503 UPLOADS_NOT_CONFIGURED.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Rate limiting (per IP; all optional, these are the defaults) ───────────
# Windows are fixed in code; only the max counts are configurable, so they can
# be tuned on Render without a redeploy. These layer ON TOP of the per-phone
# OTP caps in services/auth/otp.ts — the two are independent.
# Any route without an override falls back to the global cap, per minute.
RATE_LIMIT_GLOBAL_MAX=100
# The auth routes below are per 15 minutes.
RATE_LIMIT_OTP_REQUEST=5
RATE_LIMIT_OTP_VERIFY=10
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SIGNUP=10
# Higher: legitimate silent re-auth on app resume.
RATE_LIMIT_REFRESH=30
# POST /rides, per 15 minutes.
RATE_LIMIT_RIDE_CREATE=20
# POST /rides/:id/initiate-payment, per 15 minutes.
RATE_LIMIT_PAYMENT_INIT=15
# POST /ussd/callback, per MINUTE — one USSD session fires many keypresses.
RATE_LIMIT_USSD_CALLBACK=60
# POST /uploads/driver-photo/signature, per 15 minutes. Each issued ticket
# authorizes a write into our Cloudinary account.
RATE_LIMIT_UPLOAD_SIGNATURE=10

# ── Safety (Phase 4) ──────────────────────────────────────────────────────
# Public origin used to build the SOS tracking link texted to a rider's
# emergency contact. Must be externally reachable — the recipient opens it on
# their own phone. Defaults to http://localhost:PORT for local dev.
# Production: "https://campusride-server-aaum.onrender.com"
PUBLIC_BASE_URL=""

# Fixed number texted on every SOS alongside the rider's own contact, so an
# SOS from a rider with no saved contact still reaches a human. Unset means
# support simply isn't notified; the SOS itself still works.
SUPPORT_CONTACT_PHONE=""

# POST /rides/:id/sos, per 15 min. Each SOS sends real SMS, so it is bounded —
# but set high enough that a frightened rider tapping repeatedly is never
# the person it blocks.
RATE_LIMIT_SOS=20

# ── Feature flags ─────────────────────────────────────────────────────────
# USSD channel kill-switch. Default false: while off, POST /ussd/callback is
# not registered (404), which also closes the unauthenticated rider
# auto-provisioning that callback triggers. Leave false until the callback has
# a Moolre gateway IP allowlist or a shared secret.
ENABLE_USSD=false

# Dev-only simulated driver that drives every new ride through to COMPLETED.
# Never enable in production.
ENABLE_MOCK_DRIVER=false

# ── Seeding ───────────────────────────────────────────────────────────────
# Read by prisma/seed.ts. When "true" the seed also creates the ZoneAdjacency
# graph (which zones are adjacent for dispatch); when false/unset it seeds
# zones only. `npm run db:seed:dev` sets it true, `db:seed:test` sets it
# false, so the test suite's dispatch fixtures stay deterministic.
SEED_ZONE_ADJACENCY=false
