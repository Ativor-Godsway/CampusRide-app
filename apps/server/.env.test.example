# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE for apps/server/.env.test (the real file is GITIGNORED).
# Copy to `.env.test`. Loaded by config.ts when NODE_ENV=test (vitest sets it).
#
# Tests run best against a LOCAL Postgres — the integration suite issues hundreds
# of sequential queries and is fast/deterministic locally (~12s) but 400–540s per
# file, flaky, and prone to SIGSEGV against a remote auto-suspending Neon branch.
# Start one with `docker compose -f docker-compose.yml up -d` (see repo root) or
# use a native local Postgres. src/test/setup.ts aborts if this points at prod.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=test

# Local Postgres. With the provided docker-compose: user/password postgres, db rida_test.
# With a native install, use your local role (e.g. your OS user) and no password.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rida_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rida_test?schema=public"

PORT=3000

# Test-only signing secret — any random value. NOT the prod secret.
JWT_SECRET="replace-with-a-test-only-random-secret"

MNOTIFY_ENABLED=false
MOOLRE_ENABLED=false
MOOLRE_BASE_URL="https://sandbox.moolre.com"
OTP_PROVIDER="dummy"
ENABLE_MOCK_DRIVER=false
DEMO_OTP_CORS_ORIGINS=""
