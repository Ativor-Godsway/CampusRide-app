# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE for apps/server/.env.development (the real file is GITIGNORED).
# Copy to `.env.development` and fill in your Neon `dev` branch URLs.
# Loaded by config.ts when NODE_ENV=development (the default for local dev).
# Production values live ONLY in Render — see docs/environments.md.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Neon `dev` branch — POOLED endpoint. Append pgbouncer=true&connection_limit=5.
DATABASE_URL="postgresql://<user>:<password>@<dev-pooler-host>.neon.tech/<db>?sslmode=require&pgbouncer=true&connection_limit=5"
# Neon `dev` branch — DIRECT (non-pooled) endpoint (migrations/DDL).
DIRECT_URL="postgresql://<user>:<password>@<dev-direct-host>.neon.tech/<db>?sslmode=require"

PORT=3000

# Dev-only signing secret — generate with: openssl rand -hex 32. NOT the prod secret.
JWT_SECRET="replace-with-a-dev-only-random-secret"

MNOTIFY_ENABLED=false
MOOLRE_ENABLED=false
MOOLRE_BASE_URL="https://sandbox.moolre.com"
OTP_PROVIDER="dummy"
ENABLE_MOCK_DRIVER=false
DEMO_OTP_CORS_ORIGINS=""
