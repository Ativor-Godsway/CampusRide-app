{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // Explicit, because TypeScript 6 changed how ambient @types packages are
    // discovered: `tsc -p` still found @types/node automatically, but ts-node
    // (which the db:migrate:test / db:seed:test / db:guard scripts run on)
    // did not, and failed with "Cannot find name 'process'". Naming it here
    // makes both paths resolve the same set.
    "types": ["node"],
    "sourceMap": true,
    // No "baseUrl": TypeScript 6 deprecates it (TS5101) and removes it in 7.
    // Since TS 5, "paths" entries resolve relative to the directory holding
    // this tsconfig, which is what the relative paths below already assume —
    // so dropping baseUrl changes nothing about resolution.
    "paths": {
      "@rida/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "prisma"]
}
