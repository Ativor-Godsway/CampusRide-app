# Origin of the CampusRide API. Inlined into the bundle at BUILD time, so a
# change here needs a rebuild, not just a restart.
# Local development (the server's default port):
VITE_API_URL=http://localhost:3000
# Production: the public URL of campusride-server:
# VITE_API_URL=https://api.campusride.app

# Error reporting (optional; off when unset). The DSN of the admin site's
# Sentry project — DEPLOY.md, "Monitoring". Also inlined at build time.
# VITE_SENTRY_DSN=
