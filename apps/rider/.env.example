# Mapbox public access token (pk.*) for the Static Images API, used to
# render the campus map on the ride-location screen. Free tier is enough.
# Get one at https://account.mapbox.com/access-tokens/
# Expo inlines EXPO_PUBLIC_* vars into the JS bundle at build time.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Backend API base URL. Set to your machine's LAN IP (not localhost) so a
# phone on the same network can reach the dev server via Expo Go.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Deployed backend (Render):
# EXPO_PUBLIC_API_URL=https://campusride-server-aaum.onrender.com
#
# To point the app at the server on YOUR MAC, don't edit this line: put
#   EXPO_PUBLIC_API_URL=http://<your-mac-wifi-ip>:3000
# in apps/rider/.env.development.local instead. Expo reads that file only
# under `expo start`, never for a release build, and a release build refuses
# a local address anyway. Delete the file to go back to production.
# Step by step: docs/testing/SOLO_TESTING.md

# NOTE: there are deliberately NO Cloudinary values here.
# Image uploads are signed server-side (POST /uploads/driver-photo/signature)
# and the app holds no Cloudinary credential. The old
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME / EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET
# pair was removed in Phase 2: anything EXPO_PUBLIC_* is inlined into the
# shipped bundle, so an unsigned upload preset published there let anyone
# upload into the Cloudinary account. The server-side vars live in
# apps/server/.env.example (CLOUDINARY_CLOUD_NAME / _API_KEY / _API_SECRET).
