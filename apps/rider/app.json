{
  "expo": {
    "name": "CampusRide",
    "owner": "campusride-gh",
    "slug": "campusride-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "campusride-rider",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.campusride.rider",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.campusride.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F7F6"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#19743C",
          "defaultChannel": "ride-updates"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusRide uses your location to find the nearest pickup zone."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "SERVER_URL": "https://api.campusride.app",
      "eas": {
        "projectId": "bd9bc984-c9f4-4569-acd5-14d9db845734"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/bd9bc984-c9f4-4569-acd5-14d9db845734",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
