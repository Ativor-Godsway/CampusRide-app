{
  "expo": {
    "name": "CampusRide",
    "owner": "campusride-gh",
    "slug": "campusride-rider",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "campusride-rider",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "gh.edu.ug.rida.rider"
    },
    "android": {
      "package": "gh.edu.ug.rida.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F7F6"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusRide uses your location to find the nearest pickup zone."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "SERVER_URL": "https://campusride-server-aaum.onrender.com",
      "eas": {
        "projectId": "bd9bc984-c9f4-4569-acd5-14d9db845734"
      }
    }
  }
}
