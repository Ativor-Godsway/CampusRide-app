{
  "expo": {
    "name": "CampusRide",
    "owner": "campusride-gh",
    "slug": "campusride-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "campusride-rider",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.campusride.rider",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.campusride.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F7F6"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#19743C",
          "defaultChannel": "ride-updates"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusRide uses your location to find the nearest pickup zone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
            "@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
            "@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
            "@expo-google-fonts/figtree/800ExtraBold/Figtree_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "android": {
            "dark": {
              "image": "./assets/splash-icon.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "SERVER_URL": "https://api.campusride.app",
      "eas": {
        "projectId": "bd9bc984-c9f4-4569-acd5-14d9db845734"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/bd9bc984-c9f4-4569-acd5-14d9db845734",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
