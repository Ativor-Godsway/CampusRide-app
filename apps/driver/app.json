    "android": {
      "package": "com.campusride.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1311"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "CampusRide Driver doesn't use Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#19743C",
          "defaultChannel": "ride-requests"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusRide Driver uses your location while you are online to match you with nearby ride requests and to show riders on your trip where you are.",
          "motionUsagePermission": "CampusRide Driver doesn't use motion and fitness data.",
          "locationAlwaysAndWhenInUsePermission": "CampusRide Driver uses your location while you are online, even when the app is closed or not in use, to share your position with riders on your trip and match you with nearby ride requests. Location sharing stops when you go offline.",
          "locationAlwaysPermission": "CampusRide Driver uses your location while you are online, even when the app is closed or not in use, to share your position with riders on your trip and match you with nearby ride requests. Location sharing stops when you go offline.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CampusRide Driver uses your photo library so you can choose your profile photo. Riders see it to recognise you at pickup, and CampusRide checks it before approving you as a driver.",
          "cameraPermission": "CampusRide Driver uses your camera so you can take your profile photo. Riders see it to recognise you at pickup, and CampusRide checks it before approving you as a driver.",
          "microphonePermission": "CampusRide Driver doesn't record audio or video and never uses the microphone."
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
            "@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
            "@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
            "@expo-google-fonts/figtree/800ExtraBold/Figtree_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "android": {
            "dark": {
              "image": "./assets/splash-icon.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "SERVER_URL": "https://api.campusride.app",
      "eas": {
        "projectId": "1fa78ede-bba8-434c-a6be-a6a7a8306392"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1fa78ede-bba8-434c-a6be-a6a7a8306392",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
