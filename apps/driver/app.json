{
  "expo": {
    "name": "CampusRide Driver",
    "owner": "campusride-gh",
    "slug": "campusride-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "campusride-driver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.campusride.driver",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.campusride.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F7F6"
      },
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#19743C",
          "defaultChannel": "ride-requests"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusRide Driver uses your location to show riders where you are and to match you with nearby rides."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CampusRide Driver uses your photos so you can add a profile photo for approval.",
          "cameraPermission": "CampusRide Driver uses your camera so you can take a profile photo for approval."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "SERVER_URL": "https://api.campusride.app",
      "eas": {
        "projectId": "1fa78ede-bba8-434c-a6be-a6a7a8306392"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1fa78ede-bba8-434c-a6be-a6a7a8306392",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
