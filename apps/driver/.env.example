# Backend API base URL. Set to your machine's LAN IP (not localhost) so a
# phone on the same network can reach the dev server via Expo Go.
# Expo inlines EXPO_PUBLIC_* vars into the JS bundle at build time.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Deployed backend (Render):
# EXPO_PUBLIC_API_URL=https://campusride-server-aaum.onrender.com

# Mapbox public access token (pk.*) for the Static Images API, used to render
# the campus map. Free tier is enough.
# Get one at https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=

# NOTE: there are deliberately NO Cloudinary values here.
# Driver photo uploads are signed server-side (POST
# /uploads/driver-photo/signature) — the app holds no Cloudinary credential.
# The old EXPO_PUBLIC_CLOUDINARY_* unsigned-preset variables were removed in
# Phase 2 because anything EXPO_PUBLIC_* is inlined into the shipped bundle
# and is therefore extractable by anyone who unpacks the app.
